{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Terrarium",
  "version": "0.1.0",
  "identifier": "io.github.rahul445.terrarium",
  "build": {
    "frontendDist": "../../../ui",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Terrarium",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png"
    ],
    "macOS": {
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist"
    }
  }
}
