{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Only the local main shell may invoke the explicitly listed application commands. Plugin templates have no independent IPC authority.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "notification:default",
    "allow-snapshot",
    "allow-profile-startup",
    "allow-add-item",
    "allow-toggle-item",
    "allow-bump-item",
    "allow-delete-item",
    "allow-restore-item",
    "allow-simulate-conflict",
    "allow-run-benchmark",
    "allow-open-external",
    "allow-plugins",
    "allow-stage-install",
    "allow-confirm-install",
    "allow-cancel-install",
    "allow-rollback-plugin",
    "allow-set-plugin-removed",
    "allow-trusted-signers",
    "allow-service",
    "allow-service-net",
    "allow-list-themes",
    "allow-install-theme",
    "allow-remove-theme",
    "allow-create-backup",
    "allow-list-backups",
    "allow-restore-backup",
    "allow-view-template",
    "allow-run-query",
    "allow-run-action",
    "allow-command",
    "allow-describe-commands",
    "allow-list-spaces",
    "allow-create-space",
    "allow-rename-space",
    "allow-set-space-removed",
    "allow-sync-status",
    "allow-remove-sync-device",
    "allow-start-pairing",
    "allow-cancel-pairing",
    "allow-join-space",
    "allow-sync-now",
    "allow-recovery-phrase",
    "allow-connect-drive",
    "allow-disconnect-drive"
  ]
}
